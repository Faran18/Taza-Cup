# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tazacup

# Get a free key at https://aistudio.google.com/apikey — no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Cloud API (Meta) — from developers.facebook.com, WhatsApp product setup
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_yourself

# Port the backend runs on locally
PORT=4000

# Your deployed frontend URL, for CORS. Use http://localhost:3000 while developing.
FRONTEND_URL=http://localhost:3000
